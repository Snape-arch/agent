{
  "listen_host": "0.0.0.0",
  "listen_port": 18790,
  "model_provider": {
    "provider": "${MODEL_PROVIDER:-deepseek}",
    "base_url": "${MODEL_BASE_URL:-https://api.deepseek.com/v1}",
    "model": "${MODEL_NAME:-deepseek-chat}",
    "api_key": "${MODEL_API_KEY:-}",
    "timeout_s": 120.0
  },
  "mtclaw": {
    "enabled": "${MTCLAW_ENABLED:-false}",
    "base_url": "${MTCLAW_BASE_URL:-http://127.0.0.1:18791}",
    "model": "function-router",
    "timeout_s": 120.0,
    "fallback_on_error": "${MTCLAW_FALLBACK_ON_ERROR:-true}"
  },
  "routing": {
    "temperature": 0.0
  },
  "upstream": {
    "temperature": 0.7
  },
  "max_tool_rounds": 12,
  "tool_exec_timeout_s": 30,
  "routing_timeout_s": 10.0,
  "fr_completion_check": { "enabled": true, "mode": "permissive", "always_true": false },
  "fr_context_history": { "enabled": true },
  "fr_context_preserve": { "enabled": false },
  "debug_logging": { "enabled": false }
}
