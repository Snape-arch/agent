{
  "name": "clawos-coding",
  "displayName": "ClawOS Coding",
  "publisher": "snape-arch",
  "license": "MIT",
  "description": "Send trusted VS Code context to the local ClawOS coding agent.",
  "version": "0.1.0",
  "scripts": {
    "check": "node --check extension.js"
  },
  "engines": {"vscode": "^1.85.0"},
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:clawos.inspectContext",
    "onCommand:clawos.runCodingTask",
    "onCommand:clawos.showLastChanges",
    "onCommand:clawos.rewindLastTask"
  ],
  "contributes": {
    "commands": [
      {"command": "clawos.inspectContext", "title": "ClawOS: Inspect Context"},
      {"command": "clawos.runCodingTask", "title": "ClawOS: Run Coding Task"},
      {"command": "clawos.showLastChanges", "title": "ClawOS: Show Last Changes"},
      {"command": "clawos.rewindLastTask", "title": "ClawOS: Rewind Last Task"}
    ],
    "configuration": {
      "title": "ClawOS",
      "properties": {
        "clawos.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:18790"
        },
        "clawos.requestTimeoutSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 10,
          "maximum": 1800
        }
      }
    }
  }
}
