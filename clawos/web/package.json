{
  "name": "clawos-web",
  "private": true,
  "version": "0.22.0",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:budget": "pnpm build && node scripts/check_bundle_budget.mjs",
    "verify:plugins": "node scripts/verify-plugin-architecture.mjs",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:frontend": "vitest run --coverage",
    "test:frontend:watch": "vitest",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitest/coverage-v8": "3.2.4",
    "axe-core": "4.10.3",
    "jsdom": "26.1.0",
    "typescript": "^5.6.3",
    "vitest": "3.2.4"
  }
}
