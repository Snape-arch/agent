MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
MODEL_API_KEY=replace-with-your-key
CLAWOS_MEMORY_DB=./data/memoryos.db
VECTOR_PROVIDER=chroma
CHROMA_DIR=./data/chroma
EMBEDDING_PROVIDER=hash
# To enable local Qwen3 embeddings after manual model download:
# EMBEDDING_PROVIDER=qwen3
# EMBEDDING_MODEL_PATH=../tools/models/qwen3-embedding-0.6b
# EMBEDDING_DIM=1024
# Optional local reranker after Chroma recall:
# RERANKER_PROVIDER=qwen3
# RERANKER_MODEL_PATH=../tools/models/qwen3-reranker-0.6b
# RERANKER_RECALL_K=30
# RERANKER_TOP_K=5
MTCLAW_ENABLED=true
MTCLAW_BASE_URL=http://127.0.0.1:18791
MTCLAW_FALLBACK_ON_ERROR=true

# Local Qwen GGUF via llama.cpp OpenAI-compatible server.
# Model dependency manifest: clawos/models/qwen3_5_9b_q4_k_m.json
# Download target: tools/models/qwen3.5-9b-gguf/Qwen3.5-9B-Q4_K_M.gguf
# MODEL_PROVIDER=qwen
# MODEL_BASE_URL=http://127.0.0.1:8000/v1
# MODEL_NAME=Qwen3.5-9B-Q4_K_M
# MODEL_REQUIRES_API_KEY=false

# ---------------------------------------------------------------------------
# Feishu work connector (v2). Fill from a DEDICATED TEST tenant only.
# NEVER commit real secrets, tokens, or open_ids. FEISHU_LIVE stays false until
# every automated gate passes AND the user explicitly authorizes a live run.
# ---------------------------------------------------------------------------
# Required for live mode:
FEISHU_APP_ID=cli_replace_with_your_app_id
FEISHU_APP_SECRET=replace-with-your-app-secret
FEISHU_TENANT_ID=clawos-test
FEISHU_APPROVAL_CODE=replace-with-published-approval-code
FEISHU_APPROVAL_FORM_CONTROL_ID=replace-with-approval-body-widget-id
FEISHU_APPROVAL_INITIATOR_OPEN_ID=ou_replace_with_initiator_open_id
FEISHU_ALLOWED_CHAT_IDS=oc_replace_with_test_chat_id
FEISHU_APPROVER_OPEN_IDS=ou_replace_with_authorized_approver_open_id
FEISHU_LIVE=false
# Optional:
FEISHU_EVENT_MODE=long_connection
# FEISHU_ALLOWED_TARGET_OPEN_IDS=ou_optional_direct_message_target
# Only when FEISHU_EVENT_MODE=webhook:
# FEISHU_VERIFICATION_TOKEN=replace-with-webhook-verification-token
# FEISHU_ENCRYPT_KEY=replace-with-webhook-encrypt-key
# FEISHU_APPROVAL_TIMEOUT_MINUTES=1440
# FEISHU_SEND_TIMEOUT_SECONDS=15
# FEISHU_SYNC_LIMIT=50
# FEISHU_MESSAGE_RETENTION_DAYS=30
