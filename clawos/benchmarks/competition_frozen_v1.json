{
  "name": "competition-frozen-v1",
  "description": "File-backed frozen acceptance suite covering meeting, research, learning, Git collaboration, templates, project scaffolding, office artifacts, and core tools.",
  "thresholds": {
    "min_pass_rate": 1.0,
    "max_p95_latency_ms": 5000.0
  },
  "cases": [
    {
      "name": "meeting_create_structured_record",
      "scenario": "meeting",
      "tool": "meeting_workflow",
      "args": {
        "action": "create",
        "title": "Frozen benchmark weekly sync",
        "meeting_date": "2026-06-17",
        "attendees": ["Alice", "Bob"],
        "agenda": ["progress", "risks", "next steps"]
      },
      "expected": {
        "ok": true,
        "status": "success",
        "tool": "meeting_workflow",
        "data_paths": ["meeting.id", "meeting.title", "meeting.agenda"],
        "data_contains_text": ["Frozen benchmark weekly sync"]
      },
      "max_latency_ms": 3000
    },
    {
      "name": "meeting_audio_transcript_import",
      "scenario": "meeting",
      "tool": "meeting_workflow",
      "args": {
        "action": "audio_import",
        "audio_path": "${tmpdir}/meeting/frozen-sync.wav",
        "transcript_path": "${tmpdir}/meeting/frozen-sync-transcript.txt",
        "title": "Frozen transcript review",
        "_benchmark_fixtures": [
          {"path": "${tmpdir}/meeting/frozen-sync.wav", "bytes_hex": "524946460000000057415645"},
          {"path": "${tmpdir}/meeting/frozen-sync-transcript.txt", "content": "Alice: We will ship the MTClaw Windows launcher. Bob: Risk is missing frozen benchmarks."}
        ]
      },
      "expected": {
        "ok": true,
        "status": "success",
        "tool": "meeting_workflow",
        "data_paths": ["meeting.meeting.id", "meeting.audio_path", "meeting.transcript_status", "meeting.diarization"],
        "data_contains_text": ["transcript_imported"]
      },
      "max_latency_ms": 3000
    },
    {
