{
  "name": "clawvision",
  "private": true,
  "version": "0.22.0",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "python backend/server.py",
    "sdk:demo": "python examples/train_demo.py",
    "build": "tsc -b && vite build",
    "build:budget": "pnpm build && node scripts/check_bundle_budget.mjs",
    "verify:plugins": "node scripts/verify-plugin-architecture.mjs",
    "test:backend": "python -m unittest discover -s tests -v",
    "test:quality": "python scripts/quality_gate.py",
    "test:scale": "python scripts/scale_benchmark.py --profile quick",
    "test:analytics": "python scripts/analytics_benchmark.py --profile quick",
    "test:ml-ecosystem": "python scripts/ml_ecosystem_acceptance.py",
    "test:professional-3d": "python scripts/professional_3d_acceptance.py",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:frontend": "vitest run --coverage",
    "test:frontend:watch": "vitest",
    "test:adapters": "python scripts/stress_adapters.py",
    "test:performance": "python scripts/concurrent_sdk_benchmark.py",
    "test:restore": "python scripts/backup_rehearsal.py",
    "test:acceptance": "python scripts/acceptance_p0.py",
    "test:worker": "python scripts/standalone_worker_check.py",
    "test:synthesis": "python scripts/synthesis_acceptance.py",
    "test:vision": "python scripts/vision_acceptance.py",
    "test:release": "python scripts/quality_gate.py && python -m coverage run -m unittest discover -s tests -v && python scripts/check_coverage.py && pnpm test:frontend && python scripts/release_check.py && python scripts/scale_benchmark.py --profile quick && python scripts/analytics_benchmark.py --profile quick && python scripts/acceptance_p0.py && python scripts/standalone_worker_check.py && python scripts/synthesis_acceptance.py && python scripts/vision_acceptance.py && node scripts/verify-plugin-architecture.mjs && node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build && node scripts/check_bundle_budget.mjs && python scripts/soak_test.py --minutes 0.02 --interval 0.05",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitest/coverage-v8": "3.2.4",
    "axe-core": "4.10.3",
    "jsdom": "26.1.0",
    "typescript": "^5.6.3",
    "vitest": "3.2.4"
  }
}
